rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: userId (Auth UID)
    // Fields: name, phone, profile_image, role, xp_total, level, current_streak, last_run_date, total_km, city, bio
    //
    // Collection: runs
    // Document ID: runId
    // Fields: user_id, distance, duration, pace, route, created_at, user_name, user_image
    //
    // Collection: events
    // Document ID: eventId
    // Fields: title, description, image, location, date_time, created_by, participant_count
    //
    // Collection: ads
    // Document ID: adId
    // Fields: title, image_url, link, active
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.uid == "JVl5Q91AN3O5loqIUbMwdMqp8gB2" ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin') ||
         (request.auth.token.email == "lucasf_freitas99@hotmail.com"));
    }

    function isSponsor() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Patrocinador';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'role', 'xp_total', 'level']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role in ['Usuario', 'UserPro', 'Patrocinador', 'Admin', 'Ghost'];
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data);
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                       request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /medals/{medalId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /runs/{runId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isSponsor();
      allow update: if isAdmin() || (isSponsor() && resource.data.created_by == request.auth.uid);
      allow delete: if isAdmin();

      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(participantId);
        allow delete: if isOwner(participantId) || isAdmin();
      }
    }

    match /ads/{adId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
